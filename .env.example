# Copy to .env and fill in. .env is gitignored.

# Prava — dashboard.prava.space (free sandbox)
PRAVA_SECRET_KEY=
PRAVA_PUBLISHABLE_KEY=

# Google Safe Browsing Lookup API v4 — Google Cloud Console, free
GOOGLE_SAFE_BROWSING_API_KEY=

# OpenAI — injection scan and content heuristics
OPENAI_API_KEY=

# WARRANT signing key: base64 of the 32 raw ed25519 private key bytes.
# Leave blank to fall back to keys/warrant_private.key (gitignored).
# Generate with: python -m app.warrant keygen
WARRANT_SIGNING_KEY=
